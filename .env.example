# Security Lab environment template.
#
# Copy to `.env.security-lab.local` (gitignored) and fill in values you need:
#   cp .env.example .env.security-lab.local
#
# Load precedence (later files win): .env.local, .env.security-lab.local,
# SECURITY_LAB_ENV_FILE, then --env-file. Never commit real values.
# The tool only reads the variables it needs; unset keys are fine.

# ---------------------------------------------------------------------------
# Provider API keys
# ---------------------------------------------------------------------------
# Anthropic (only needed for API-backed flows; the canonical path uses `claude auth login`)
ANTHROPIC_API_KEY=
# OpenAI (judge models and OpenAI-compatible endpoints)
OPENAI_API_KEY=
# Google Gemini — set either name; the loader mirrors one to the other
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Local model server (llama-server / Ollama, OpenAI-compatible)
# ---------------------------------------------------------------------------
# The default bounded_local adapter targets http://127.0.0.1:8080/v1.
# There is no env var for the URL: pass --planner-base-url / --judge-base-url,
# or set the provider baseUrl in a target/portfolio profile.
# Default local endpoints for reference:
#   llama-server  http://127.0.0.1:8080/v1
#   ollama        http://127.0.0.1:11434/v1

# ---------------------------------------------------------------------------
# Target workspace roots referenced by target profiles
# ---------------------------------------------------------------------------
# Used by packages/attack-lab/targets/*.yaml via `repoRootEnv` and ${...} expansion
TARGET_REPO_ROOT=
PAPERCLIP_REPO_ROOT=
# Hosted/staging base URLs used by staging target profiles
TARGET_STAGING_URL=

# ---------------------------------------------------------------------------
# Target identity credentials (names are declared per profile:
# tokenEnv / cookieEnv / issuerSecretEnv; these are the shipped examples)
# ---------------------------------------------------------------------------
TARGET_USER_A_TOKEN=
TARGET_USER_B_TOKEN=
NOOD_USER_A_COOKIE=
NOOD_USER_B_COOKIE=
PAPERCLIP_BOARD_API_KEY=
PAPERCLIP_USER_A_COOKIE=
# Local JWT auth bootstrap: <ENV_PREFIX>_JWT_SECRET / _JWT_ISSUER / _JWT_AUDIENCE
CHANNEL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Runtime tuning (all optional, defaults shown)
# ---------------------------------------------------------------------------
# Default run mode: smoke | serious-local | serious-end-to-end
RUN_MODE=
# Campaign lock staleness threshold in ms (default 1800000)
STALE_LOCK_MS=
# Heartbeat interval in ms for long operations (default 30000)
HEARTBEAT_INTERVAL_MS=
# Comma-separated manifest parsers to disable during static scanning
DISABLED_MANIFEST_PARSERS=

# ---------------------------------------------------------------------------
# Local test fixture server
# ---------------------------------------------------------------------------
# Port for `npm run fixture:server` (default 4317)
SECURITY_LAB_FIXTURE_PORT=

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------
# Path to an additional env file to load (see precedence above)
SECURITY_LAB_ENV_FILE=

# ---------------------------------------------------------------------------
# Host execution (opt-in, disabled by default)
# ---------------------------------------------------------------------------
# Providers that run code on this machine (Claude Code / Codex CLI / Pi CLI
# workers, bounded-local shell) are refused unless this is set to 1.
# WARNING: a scanned repository can then cause arbitrary commands to run as
# your user. Prefer running inside a container or VM.
SECURITY_LAB_ALLOW_HOST_EXECUTION=
